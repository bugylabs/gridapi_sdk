<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>io.gridapi</groupId>
  <artifactId>gridapi-sdk</artifactId>
  <version>1.0.0</version>
  <packaging>jar</packaging>

  <name>GridAPI Java SDK</name>
  <description>Official Java client for the GridAPI public REST API</description>
  <url>https://github.com/bugylabs/gridapi-sdk</url>

  <licenses>
    <license>
      <name>BugyLabs Proprietary Non-Commercial License</name>
      <url>https://github.com/bugylabs/gridapi-sdk/blob/main/LICENSE</url>
    </license>
  </licenses>

  <developers>
    <developer>
      <name>GridAPI</name>
      <url>https://gridapi.in</url>
    </developer>
  </developers>

  <scm>
    <url>https://github.com/bugylabs/gridapi-sdk</url>
    <connection>scm:git:https://github.com/bugylabs/gridapi-sdk.git</connection>
    <developerConnection>scm:git:git@github.com:gridapi/gridapi_sdk.git</developerConnection>
  </scm>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>21</maven.compiler.release>
  </properties>

  <!-- Intentionally no <dependencies>: the SDK uses only the JDK. -->
  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-source-plugin</artifactId>
        <version>3.3.1</version>
        <executions><execution><id>attach-sources</id><goals><goal>jar-no-fork</goal></goals></execution></executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-javadoc-plugin</artifactId>
        <version>3.11.2</version>
        <configuration><doclint>none</doclint></configuration>
        <executions><execution><id>attach-javadocs</id><goals><goal>jar</goal></goals></execution></executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-gpg-plugin</artifactId>
        <version>3.2.7</version>
        <executions><execution><id>sign-artifacts</id><phase>verify</phase><goals><goal>sign</goal></goals></execution></executions>
      </plugin>
      <plugin>
        <groupId>org.sonatype.central</groupId>
        <artifactId>central-publishing-maven-plugin</artifactId>
        <version>0.12.0</version>
        <extensions>true</extensions>
        <configuration>
          <publishingServerId>central</publishingServerId>
          <autoPublish>false</autoPublish>
          <waitUntil>validated</waitUntil>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
