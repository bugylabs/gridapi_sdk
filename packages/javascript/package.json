{
  "name": "@gridapi/sdk",
  "version": "1.0.0",
  "description": "Official TypeScript/JavaScript SDK for the GridAPI REST API",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.cjs.json && node scripts/finalize.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test test/*.test.mjs"
  },
  "devDependencies": {
    "typescript": "^5.7.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bugylabs/gridapi_sdk.git",
    "directory": "packages/javascript"
  },
  "homepage": "https://github.com/bugylabs/gridapi_sdk/tree/main/packages/javascript#readme",
  "bugs": {
    "url": "https://github.com/bugylabs/gridapi_sdk/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
